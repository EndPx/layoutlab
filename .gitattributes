# Preserve upstream asset bytes so source BOM hashes survive Windows checkout.
assets/** -text
# Preserve the converted GLB derivative byte-for-byte as well.
*.glb -text
# M6A: frozen benchmark fixtures are hashed raw byte-for-byte.
# Windows autocrlf must never rewrite these bytes on checkout.
fixtures/benchmark/*.json -text
# Operations inputs/proofs also record raw hashes; keep them stable on checkout.
fixtures/operations/**/*.json -text

# Immutable archived runtime has a raw-byte SHA; preserve it on every platform.
packages/simulation/archive/0.1.0/runtime.mjs -text
