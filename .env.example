# LayoutLab server-side environment template. Copy to .env (git-ignored) and fill locally.
# NEVER put these keys in client-side Vite vars (no VITE_ prefix) or commit .env.

# Server-only provider configuration. Fill with your provider's supported values.
MODEL_API_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
# Optional Gater example: MODEL_API_BASE_URL=https://api.gater.ai.id/v1
# Optional Gater example: MODEL_ID=glm-5-3-flash
# Blank neutral values take precedence over legacy aliases and use defaults.
# Legacy META_API_BASE_URL and META_MODEL_ID aliases are used only when the
# corresponding MODEL_API_BASE_URL and MODEL_ID variables are omitted.

# Bounded run limits (brief section 18/21). Env values can only lower these;
# the server clamps to the brief caps (3 proposals, 4 requests, 120000 ms).
MAX_PROPOSALS_PER_RUN=3
MAX_MODEL_REQUESTS_PER_RUN=4
RUN_TIMEOUT_MS=120000

# Native API server (loopback by default; the Vite dev server proxies /api).
API_HOST=127.0.0.1
API_PORT=3001
