# LayoutLab server-side environment template. Copy to .env (git-ignored) and fill locally.
# NEVER put these keys in client-side Vite vars (no VITE_ prefix) or commit .env.

# Meta Model API (https://dev.meta.ai/docs/quickstart). Server only.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
MODEL_API_KEY=
# NOTE: -contributor model variants are discounted in exchange for
# training-data use. The planner discloses this when live mode is selected.

# Bounded run limits (brief section 18/21). Env values can only lower these;
# the server clamps to the brief caps (3 proposals, 4 requests, 120000 ms).
MAX_PROPOSALS_PER_RUN=3
MAX_MODEL_REQUESTS_PER_RUN=4
RUN_TIMEOUT_MS=120000

# Native API server (loopback by default; the Vite dev server proxies /api).
API_HOST=127.0.0.1
API_PORT=3001
